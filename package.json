{
  "name": "type-blitz",
  "version": "1.0.0",
  "description": "80s Retro Synthwave Terminal Typing Game with Literature Streaming",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./engine": {
      "import": "./dist/engine/gameEngine.js",
      "types": "./dist/engine/gameEngine.d.ts"
    },
    "./renderer": {
      "import": "./dist/renderer/index.js",
      "types": "./dist/renderer/index.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    }
  },
  "bin": {
    "type-blitz": "./bin/type-blitz.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "game": "node dist/index.js",
    "test": "tsx src/__tests__/engine.test.ts && tsx src/__tests__/renderer.test.ts && tsx src/__tests__/scores.test.ts && tsx src/__tests__/audio.test.ts"
  },
  "keywords": [
    "tui",
    "typing-game",
    "synthwave",
    "literature",
    "terminal",
    "retro"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "figlet": "^1.7.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.5.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
