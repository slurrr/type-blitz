{
  "name": "type-blitz",
  "version": "1.0.0",
  "description": "80s Retro Synthwave Terminal Typing Game with Literature Streaming",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "type-blitz": "./bin/type-blitz.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "vite build",
    "start": "tsx src/index.ts",
